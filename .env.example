# Where this server is reached; trusted by the sign-in origin check (lib/auth.ts).
AUTH_URL=http://localhost:3000
# Signs session cookies; at least 32 characters in production.
AUTH_SECRET=
# "Continue with OrangeCat"; the button shows only when both are set.
ORANGECAT_OAUTH_CLIENT_ID=
ORANGECAT_OAUTH_CLIENT_SECRET=
# The shared sign-in (Google, Apple, GitHub, X, Facebook); shown only when all three are set.
SIGNIN_ISSUER=
SIGNIN_CLIENT_ID=
SIGNIN_CLIENT_SECRET=
# Account mail: sign-in link, password recovery, address confirmation. On the
# box the fleet key reaches the app; leave empty here to keep those hidden.
RESEND_API_KEY=
DATABASE_URL=postgresql://substrata:replace-me@127.0.0.1:5432/substrata
SUBSTRATA_REVIEWER_ACTOR_IDS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Free chain, per-project Google key (ai-kit freeChain): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Seals signed-in readers' own AI keys at rest (openssl rand -base64 32). Unset = browser-only keys.
SUBSTRATA_BYOK_SECRET=
# Bearer token the box's cron sends to /api/cron/*. Unset = the cron routes refuse every call.
CRON_SECRET=
# Optional. Loki feedback widget token (app/layout.tsx); unset = no widget.
NEXT_PUBLIC_FC_WIDGET_TOKEN=
# Optional. OpenAlex API key (lib/science-sources.ts).
OPENALEX_API_KEY=

# Web search for the Ask assistant (lib/chat-web.ts). One of these makes
# web_search available; without any, a question the corpus does not cover
# gets background knowledge marked "Outside the corpus" instead of a wall.
# Production copies the box's SearXNG settings from Causius's env with
# .github/workflows/share-search-backend.yml.
SEARXNG_URL=
SEARXNG_TOKEN=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# The fleet chat-review loop (docs/INFRASTRUCTURE.md, "Chat review"). One
# value shared by every app on the box, written by Loki's
# share-chat-review-token workflow; GET /api/chat/review-export refuses
# with 503 while it is unset.
CHAT_REVIEW_TOKEN=
