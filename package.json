    "@bitbaum/geo-kit": "git+https://github.com/bitbaum/geo-kit.git#a337aec928cf7804fecf459c308d366b90f4b2fa",
    "@bitbaum/searchkit": "git+https://github.com/bitbaum/searchkit.git#v0.2.2",
    "@bitbaum/whenkit": "git+https://github.com/bitbaum/whenkit.git#v0.3.2",
    "better-auth": "^1.7.7",
    "bip-kit": "^0.5.2",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "listkit": "git+https://github.com/bitbaum/listkit.git#v0.1.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
