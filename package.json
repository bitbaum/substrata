{
  "name": "substrata",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=4 test/*.test.ts",
    "research:listings": "tsx scripts/research/listings.ts",
    "research:accept-events": "tsx scripts/research/accept-events.ts",
    "research:occupations": "tsx scripts/research/occupations.ts",
    "research:usgs": "python3 scripts/research/usgs-mcs.py",
    "research:eia": "python3 scripts/research/eia-energy.py",
    "research:uranium": "python3 scripts/research/wna-uranium.py",
    "research:producers": "python3 scripts/research/usgs-myb-producers.py",
    "research:usgs-relations": "tsx scripts/research/build-usgs-relations.ts",
    "research:derived-relations": "tsx scripts/research/build-derived-relations.ts",
    "research:alias-candidates": "tsx scripts/research/alias-candidates.ts",
    "research:producer-places": "python3 scripts/research/geocode-producers.py",
    "research:restrictions": "python3 scripts/research/oecd-export-restrictions.py",
    "research:sanctions": "python3 scripts/research/sanctions.py",
    "quality": "tsx scripts/quality/run.ts",
    "company:add": "tsx scripts/registry/add.ts",
    "company:refresh": "tsx scripts/registry/refresh.ts",
    "check:ask-layout": "node scripts/ux/ask-layout.mjs",
    "check:home-layout": "node scripts/ux/home-layout.mjs",
    "check:places-layout": "node scripts/ux/places-layout.mjs",
    "check:profile-layout": "node scripts/ux/profile-layout.mjs",
    "check:company-layout": "node scripts/ux/company-layout.mjs",
    "check:file-inputs": "chatkit-check-file-inputs app components lib",
    "verify": "pnpm run format:check && pnpm run type-check && pnpm run lint && pnpm run check:file-inputs && pnpm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@bitbaum/accountkit": "^0.9.1",
    "@bitbaum/ai-kit": "^1.21.4",
    "@bitbaum/chartkit": "^0.6.0",
    "@bitbaum/chatkit": "^0.21.2",
    "@bitbaum/design-tokens": "^1.2.0",
    "@bitbaum/geo-kit": "^0.1.2",
    "@bitbaum/searchkit": "^0.2.3",
    "@bitbaum/whenkit": "^0.3.3",
    "bip-kit": "^0.6.1",
    "d3-geo": "^3.1.1",
    "listkit": "npm:@bitbaum/listkit@^0.2.2",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sitekit": "npm:@bitbaum/sitekit@^0.4.2",
    "threadkit": "^0.1.1",
    "topojson-client": "^3.1.0",
    "unpdf": "1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
