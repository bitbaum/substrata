    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^10",
    "eslint-config-next": "^16.4.2",
    "espree": "^11.2.0",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
